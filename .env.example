# =========================================================
#  CONFIGURAÇÃO DO MERCADO PAGO (PIX)
# =========================================================
# Crie uma conta em https://www.mercadopago.com.br
# Depois acesse: https://www.mercadopago.com.br/developers
#  -> "Minhas aplicações" -> Crie uma aplicação
#  -> Copie o "Access Token (TESTE)" para testar
#  -> Quando for para produção, use o token de PRODUÇÃO

# Token de produção (vazio por padrão - preencha com o seu)
MP_ACCESS_TOKEN=APP_USR-2183579624596817-083008-f649747a8c025ebae11fc9f19ba3e0ee-79228648

# =========================================================
#  SERVIDOR
# =========================================================
PORT=3000

# URL pública onde o backend está hospedado.
# Em produção isso será algo como https://seujogo.com
# IMPORTANTE: o webhook do Mercado Pago precisa disso.
BASE_URL=http://localhost:3000

# =========================================================
#  BANCO DE DADOS (produção)
# =========================================================
# Em produção, use o Postgres gratuito do Neon (https://neon.tech)
# e cole a connection string aqui (ou nas variáveis do Render).
# Sem DATABASE_URL o servidor usa memória (ok só para testar local).
DATABASE_URL=postgresql://neondb_owner:npg_fU7bpeF3NQri@ep-small-tooth-acza42xq-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# =========================================================
#  JOGO (arquivo estático servido pelo backend)
# =========================================================
# Caminho para a pasta do jogo .html (pode apontar para a pasta match3)
GAME_DIR=/home/tiago/match3
